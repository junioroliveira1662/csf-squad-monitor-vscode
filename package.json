{
  "name": "mapa-de-agentes",
  "displayName": "CSF Squad Monitor",
  "description": "Painel da iniciativa CSF Agent Squad do Banco Carrefour para acompanhar delegações e ferramentas no GitHub Copilot.",
  "publisher": "agent-catalog-local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "mapa.agentes",
        "title": "CSF Squad Monitor: Abrir painel"
      }
    ],
    "customEditors": [
      {
        "viewType": "mapa.gravacao",
        "displayName": "CSF Squad Monitor",
        "selector": [
          {
            "filenamePattern": "*.mapa-copilot.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:.github/hooks/mapa-de-agentes.json"
  ],
  "private": true,
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out csf-squad-monitor.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "files": [
    "extension.cjs",
    "hook.cjs",
    "media/**",
    "README.md"
  ]
}
